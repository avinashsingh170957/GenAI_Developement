# Server
PORT=5000

# MySQL Database
DB_HOST=localhost
DB_USER=root
DB_PASSWORD=your_mysql_password
DB_NAME=pdf_portal
DB_PORT=3306

# JWT
JWT_SECRET=change_this_to_a_long_random_secret_key
JWT_EXPIRES_IN=1d

# Default admin (created automatically on first run if not present)
ADMIN_NAME=Administrator
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=Admin@123

# Google GenAI (Gemini) — used for RAG: embedding uploaded PDFs and
# generating answers for the user search. Get a key from https://aistudio.google.com/apikey
GOOGLE_API_KEY=your_google_ai_studio_api_key
EMBEDDING_MODEL=text-embedding-004
GENERATION_MODEL=gemini-2.5-flash
